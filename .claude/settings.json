{
  "env": {
    "CAVEMAN_DEFAULT_MODE": "lite"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch(domain:docs.anthropic.com)",
      "Skill(schedule)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(which:*)",
      "Bash(readlink:*)",
      "Bash(pwd:*)",
      "Bash(echo:*)",
      "Bash(rg *)",
      "Bash(tree:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git fetch:*)",
      "Bash(git show-ref:*)",
      "Bash(mkdir:*)",
      "Bash(stat:*)",
      "Bash(diff:*)",
      "Bash(glab:*)",
      "Bash(pytest:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(source .venv/bin/activate)",
      "Bash(.venv/bin/*)",
      "Bash(pip install:*)",
      "Bash(pip3 show:*)",
      "Bash(poetry *)",
      "Bash(npx vitest run:*)",
      "Bash(pnpm:*)",
      "Bash(docker compose:*)",
      "Bash(docker compose run:*)",
      "Bash(docker compose exec:*)",
      "Bash(docker-compose:*)",
      "Bash(docker-compose run:*)",
      "Bash(claude sessions:*)",
      "Bash(chronoctl auth login --org-name recharge)",
      "mcp__plugin_kai_atlassian__*",
      "mcp__claude_ai_Sentry__*",
      "mcp__claude_ai_Slack__*",
      "mcp__plugin_kai_watchtower__*",
      "mcp__plugin_kai_dba-mcp-prod__*"
    ],
    "deny": [
      "Bash(git commit)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(git *--force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git restore .*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(git add*)",
      "Bash(git checkout*)",
      "Bash(git branch -C*)",
      "Bash(git -C * checkout*)",
      "Bash(git -C * branch -C*)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(rm -fr *)",
      "Bash(truncate *)",
      "Bash(shred *)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(chmod -R *)",
      "Bash(chown -R *)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(killall *)",
      "Bash(pkill *)",
      "Bash(*| sh)",
      "Bash(*| sh *)",
      "Bash(*| bash)",
      "Bash(*| bash *)",
      "Bash(*| zsh)",
      "Bash(*| zsh *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.secret)",
      "Read(/Users/benheath/.ssh/**)",
      "Read(/Users/benheath/.aws/**)",
      "Read(/Users/benheath/.gnupg/**)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/Users/benheath/Developer/notes/sessions"
    ]
  },
  "model": "opus",
  "skillOverrides": {
    "simplify-code": "off",
    "write-mr": "off",
    "yeet": "off",
    "commit": "off",
    "jira": "off",
    "mr-check": "off",
    "docx": "off",
    "pdf": "off",
    "pptx": "off",
    "xlsx": "off",
    "morning": "off",
    "skill-creator": "off",
    "import-memory": "off"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Funk.aiff"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Hero.aiff"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -z \"$(find ~/.claude/.last-checkup -mtime -30 2>/dev/null)\" ]; then echo '{\"systemMessage\":\"Monthly Claude Code checkup is due: run /monthly-checkup\"}'; fi"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "kai@kai": true,
    "typescript-lsp@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "caveman@caveman": true,
    "shopify-ai-toolkit@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "kai": {
      "source": {
        "source": "directory",
        "path": "/Users/benheath/.claude/kai"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "po": {
      "source": {
        "source": "directory",
        "path": "/Users/benheath/.claude/po"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "verbose": false,
  "preferredNotifChannel": "terminal_bell"
}
